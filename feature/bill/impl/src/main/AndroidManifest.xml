<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the app manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Finding friends' numbers when adding people to a bill (People step). Asked only when the user starts searching
         contacts, or from Profile > Permissions; the system contact picker works without it. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Photographing a receipt with the camera inside the app (ReceiptCamera). Asked when the user first taps "Take a
         photo", or from Profile > Permissions. Not required: without a camera the gallery and typing still work. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Sending a bill: WhatsApp, then WhatsApp Business, must be visible to check which one is installed
         (WhatsAppSharer). -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

</manifest>
